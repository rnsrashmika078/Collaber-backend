# Server
PORT=5001
ALLOW_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# Used by the "db" compose service and to build DATABASE_URL for the backend.
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=nsf_slstinet
DB_HOST_PORT=5433

# Optional single connection string (overrides the DB_* vars above).
# Local development example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres?sslmode=disable"

# Auth (JWT)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRE=15
JWT_REFRESH_EXPIRE=7d

# Frontend URL (used to build password reset links)
FRONTEND_URL=http://localhost:3000

# Email (SMTP) - used to send password reset emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=SLSTINET <no-reply@slstinet.lk>
